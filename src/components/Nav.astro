---


const navLinks = [
  { label: "About", href: "#about" },
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="font-display text-lg font-normal text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors">
      MA<span class="text-[var(--color-accent)]">.</span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors tracking-wide"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Resume Button -->
    <a
      href="/resume.pdf"
      target="_blank"
      rel="noopener"
      class="hidden md:inline-flex items-center gap-2 text-sm px-4 py-2 border border-[var(--color-text)] text-[var(--color-text)] hover:bg-[var(--color-text)] hover:text-[var(--color-bg)] transition-all duration-200 rounded-sm"
    >
      Resume ↗
    </a>

    <!-- Mobile hamburger -->
    <button id="menu-toggle" class="md:hidden p-2" aria-label="Toggle menu">
      <span class="block w-5 h-px bg-current mb-1.5 transition-all"></span>
      <span class="block w-5 h-px bg-current mb-1.5 transition-all"></span>
      <span class="block w-3 h-px bg-current transition-all"></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[var(--color-bg)] border-t border-[var(--color-border)] px-6 py-6">
    <ul class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="text-base text-[var(--color-text)] mobile-link block">
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/resume.pdf" target="_blank" class="text-[var(--color-accent)] text-sm">
          View Resume ↗
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  #site-header.scrolled {
    background: rgba(249, 246, 241, 0.92);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--color-border);
  }
</style>

<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const mobileMenu = document.getElementById("mobile-menu")!;

  window.addEventListener("scroll", () => {
    header.classList.toggle("scrolled", window.scrollY > 24);
  });

  toggle.addEventListener("click", () => {
    mobileMenu.classList.toggle("hidden");
  });

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => mobileMenu.classList.add("hidden"));
  });
</script>
