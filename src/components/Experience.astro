---
import { EXPERIENCE, EDUCATION, CERTIFICATIONS } from "@config";
---

<section id="experience" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">

    <!-- Section header -->
    <div class="reveal mb-14">
      <p class="text-xs tracking-[0.2em] uppercase text-[var(--color-accent)] mb-2">My Journey</p>
      <h2 class="font-display text-4xl">Experience &<br/>Education</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-16">

      <!-- Experience -->
      <div>
        <h3 class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-muted)] mb-8 reveal">Work Experience</h3>
        <div class="relative pl-6 border-l border-[var(--color-border)]">
          {EXPERIENCE.map((exp, i) => (
            <div class="mb-12 last:mb-0 reveal" style={`transition-delay:${i * 0.1}s`}>
              <!-- Dot -->
              <div class="absolute -left-[5px] w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] mt-1"></div>

              <div class="flex flex-wrap justify-between items-start gap-2 mb-2">
                <h4 class="font-semibold text-[var(--color-text)]">{exp.role}</h4>
                <span class="text-xs text-[var(--color-text-muted)] bg-[var(--color-surface)] border border-[var(--color-border)] px-2 py-0.5">{exp.period}</span>
              </div>

              <p class="text-sm text-[var(--color-accent)] mb-1">{exp.company}</p>
              <p class="text-xs text-[var(--color-text-muted)] mb-4">{exp.location}</p>

              <ul class="space-y-2">
                {exp.points.map(point => (
                  <li class="text-sm text-[var(--color-text-muted)] flex gap-2">
                    <span class="text-[var(--color-accent)] flex-shrink-0 mt-0.5">—</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Education + Certs -->
      <div>
        <h3 class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-muted)] mb-8 reveal">Education</h3>
        <div class="space-y-8 mb-14">
          {EDUCATION.map((edu, i) => (
            <div class="reveal border border-[var(--color-border)] p-6" style={`transition-delay:${i * 0.1}s`}>
              <div class="flex flex-wrap justify-between items-start gap-2 mb-1">
                <h4 class="font-semibold text-[var(--color-text)] leading-snug max-w-xs">{edu.degree}</h4>
                <span class="text-xs text-[var(--color-text-muted)]">{edu.period}</span>
              </div>
              <p class="text-sm text-[var(--color-accent)] mb-1">{edu.institution}</p>
              {edu.university && <p class="text-xs text-[var(--color-text-muted)] mb-3">{edu.university}</p>}
              {edu.cgpa && <p class="text-sm font-medium mb-3">CGPA / Score: <span class="text-[var(--color-accent)]">{edu.cgpa}</span></p>}
              {edu.highlights.length > 0 && (
                <ul class="space-y-1.5">
                  {edu.highlights.map(h => (
                    <li class="text-xs text-[var(--color-text-muted)] flex gap-2">
                      <span class="text-[var(--color-accent)]">·</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>

        <!-- Certifications -->
        <h3 class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-text-muted)] mb-6 reveal">Certifications</h3>
        <div class="grid grid-cols-1 gap-3">
          {CERTIFICATIONS.map((cert, i) => (
            <div class="reveal flex items-center justify-between p-4 border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors group" style={`transition-delay:${i * 0.06}s`}>
              <div>
                <p class="text-sm font-medium text-[var(--color-text)]">{cert.name}</p>
                <p class="text-xs text-[var(--color-text-muted)]">{cert.issuer} · {cert.date}</p>
              </div>
              {cert.url && (
                <a href={cert.url} target="_blank" rel="noopener" class="text-xs text-[var(--color-accent)] opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">
                  View ↗
                </a>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
