---
import { SKILLS } from "@config";
---

<section id="skills" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="reveal mb-14">
      <p class="text-xs tracking-[0.2em] uppercase text-[var(--color-accent)] mb-2">What I Know</p>
      <h2 class="font-display text-4xl">Technical<br/>Skills</h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {SKILLS.map((group, i) => (
        <div class="reveal" style={`transition-delay:${i * 0.07}s`}>
          <h3 class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent)] mb-4">
            {group.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <span class="text-sm px-3 py-1.5 bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors duration-150 cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
