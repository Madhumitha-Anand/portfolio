---
import { ABOUT } from "@config";
---

<section id="about" class="py-24 px-6 bg-[var(--color-surface)] border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto grid md:grid-cols-[1fr_2fr] gap-16 items-start">

    <!-- Label -->
    <div class="reveal">
      <p class="text-xs tracking-[0.2em] uppercase text-[var(--color-accent)] mb-2">Who I Am</p>
      <h2 class="font-display text-4xl">About<br/>Me</h2>
    </div>

    <!-- Content -->
    <div class="reveal">
      {ABOUT.paragraphs.map((p) => (
        <p class="text-[var(--color-text-muted)] leading-relaxed mb-5 text-base">{p}</p>
      ))}

      <!-- Stats -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mt-10 pt-10 border-t border-[var(--color-border)]">
        {ABOUT.stats.map((s) => (
          <div>
            <p class="font-display text-3xl text-[var(--color-text)]">{s.value}</p>
            <p class="text-xs text-[var(--color-text-muted)] mt-1 tracking-wide">{s.label}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
