---
import { PROJECTS } from "@config";

// Show featured first, then the rest
const sorted = [...PROJECTS].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<section id="projects" class="py-24 px-6 bg-[var(--color-surface)] border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto">

    <div class="reveal mb-14 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <p class="text-xs tracking-[0.2em] uppercase text-[var(--color-accent)] mb-2">What I've Built</p>
        <h2 class="font-display text-4xl">Projects</h2>
      </div>
      <p class="text-sm text-[var(--color-text-muted)]">{PROJECTS.length} projects total</p>
    </div>

    <!-- Featured projects — large cards -->
    <div class="grid md:grid-cols-2 gap-8 mb-8">
      {sorted.filter(p => p.featured).map((project, i) => (
        <article class="reveal group border border-[var(--color-border)] bg-[var(--color-bg)] overflow-hidden hover:border-[var(--color-accent)] transition-colors duration-300" style={`transition-delay:${i * 0.08}s`}>
          <!-- Project image / placeholder -->
          <div class="h-48 bg-[var(--color-accent-light)] overflow-hidden relative">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-500"
              onerror="this.style.display='none'"
            />
            <div class="absolute top-3 left-3">
              <span class="text-xs bg-[var(--color-accent)] text-white px-2 py-0.5 tracking-wider uppercase">Featured</span>
            </div>
          </div>

          <div class="p-6">
            <h3 class="font-display text-xl mb-2">{project.title}</h3>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">{project.description}</p>

            <div class="flex flex-wrap gap-2 mb-5">
              {project.tags.map(tag => (
                <span class="text-xs px-2 py-1 bg-[var(--color-accent-light)] text-[var(--color-accent)]">{tag}</span>
              ))}
            </div>

            <div class="flex gap-4">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener" class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors flex items-center gap-1.5">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.164 6.839 9.489.5.09.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
                  GitHub
                </a>
              )}
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noopener" class="text-xs text-[var(--color-accent)] hover:underline flex items-center gap-1">
                  Live Demo ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Remaining projects — compact cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-6">
      {sorted.filter(p => !p.featured).map((project, i) => (
        <article class="reveal border border-[var(--color-border)] p-6 hover:border-[var(--color-accent)] transition-colors duration-300" style={`transition-delay:${i * 0.08}s`}>
          <h3 class="font-display text-lg mb-2">{project.title}</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">{project.description}</p>
          <div class="flex flex-wrap gap-2 mb-4">
            {project.tags.slice(0, 4).map(tag => (
              <span class="text-xs px-2 py-0.5 bg-[var(--color-accent-light)] text-[var(--color-accent)]">{tag}</span>
            ))}
          </div>
          <div class="flex gap-4">
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener" class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">GitHub ↗</a>
            )}
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noopener" class="text-xs text-[var(--color-accent)] hover:underline">Demo ↗</a>
            )}
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
