---
import { SOCIAL, SITE } from "@config";
---

<section id="contact" class="py-24 px-6 bg-[var(--color-text)]">
  <div class="max-w-6xl mx-auto">

    <div class="reveal max-w-2xl">
      <p class="text-xs tracking-[0.2em] uppercase text-[var(--color-accent)] mb-4">Let's Connect</p>
      <h2 class="font-display text-5xl text-[var(--color-bg)] leading-tight mb-6">
        Open to<br/>opportunities.
      </h2>
      <p class="text-[#a09890] leading-relaxed mb-10 text-base">
        Whether you're looking to hire, collaborate on a research project, or just want to talk AI — my inbox is open. I typically respond within 24 hours.
      </p>

      <a
        href={`mailto:${SOCIAL.email}`}
        class="inline-block text-lg font-display text-[var(--color-bg)] border-b-2 border-[var(--color-accent)] pb-1 hover:text-[var(--color-accent)] transition-colors duration-200"
      >
        {SOCIAL.email}
      </a>
    </div>

    <!-- Links row -->
    <div class="reveal mt-16 pt-10 border-t border-[#2a2520] flex flex-wrap gap-6 items-center justify-between">
      <div class="flex gap-6">
        <a href={SOCIAL.github} target="_blank" rel="noopener" class="text-sm text-[#a09890] hover:text-[var(--color-bg)] transition-colors">GitHub</a>
        <a href={SOCIAL.linkedin} target="_blank" rel="noopener" class="text-sm text-[#a09890] hover:text-[var(--color-bg)] transition-colors">LinkedIn</a>
        <a href={SOCIAL.kaggle} target="_blank" rel="noopener" class="text-sm text-[#a09890] hover:text-[var(--color-bg)] transition-colors">Kaggle</a>
        <a href="/resume.pdf" target="_blank" class="text-sm text-[#a09890] hover:text-[var(--color-bg)] transition-colors">Resume ↗</a>
      </div>
      <p class="text-xs text-[#5a5550]">
        © {new Date().getFullYear()} {SITE.title}. Built with Astro & TailwindCSS.
      </p>
    </div>

  </div>
</section>

