---
import { HERO, SOCIAL } from "@config";
---

<section id="hero" class="min-h-screen flex items-center pt-20 pb-16 px-6">
  <div class="max-w-6xl mx-auto w-full grid md:grid-cols-[1fr_auto] gap-16 items-center">

    <!-- Text Content -->
    <div>
      <p class="text-sm tracking-[0.2em] uppercase text-[var(--color-accent)] mb-6 font-medium animate-fadein" style="animation-delay:0.1s">
        {HERO.greeting}
      </p>

      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl text-[var(--color-text)] leading-[1.05] mb-6 animate-fadein" style="animation-delay:0.2s">
        {HERO.name}
      </h1>

      <div class="flex items-center gap-3 mb-8 animate-fadein" style="animation-delay:0.3s">
        <span class="w-8 h-px bg-[var(--color-accent)]"></span>
        <p class="text-lg text-[var(--color-text-muted)]">{HERO.role}</p>
      </div>

      <p class="text-base text-[var(--color-text-muted)] max-w-lg leading-relaxed mb-8 animate-fadein" style="animation-delay:0.4s">
        {HERO.bio}
      </p>

      <div class="inline-flex items-center gap-2 text-xs tracking-wider text-[var(--color-accent)] bg-[var(--color-accent-light)] px-3 py-1.5 rounded-full mb-10 animate-fadein" style="animation-delay:0.45s">
        <span class="w-1.5 h-1.5 bg-[var(--color-accent)] rounded-full animate-pulse"></span>
        {HERO.availability}
      </div>

      <div class="flex flex-wrap gap-4 animate-fadein" style="animation-delay:0.5s">
        <a href={HERO.cta.primary.href} class="px-6 py-3 bg-[var(--color-text)] text-[var(--color-bg)] text-sm hover:bg-[var(--color-accent)] transition-colors duration-200">
          {HERO.cta.primary.label}
        </a>
        <a href={HERO.cta.secondary.href} class="px-6 py-3 border border-[var(--color-border)] text-[var(--color-text)] text-sm hover:border-[var(--color-text)] transition-colors duration-200">
          {HERO.cta.secondary.label}
        </a>
      </div>

      <!-- Social icons -->
      <div class="flex gap-5 mt-10 animate-fadein" style="animation-delay:0.6s">
        <a href={SOCIAL.github} target="_blank" aria-label="GitHub" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.164 6.839 9.489.5.09.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
        </a>
        <a href={SOCIAL.linkedin} target="_blank" aria-label="LinkedIn" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href={SOCIAL.kaggle} target="_blank" aria-label="Kaggle" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.825 23.859c-.022.092-.117.141-.281.141h-3.139c-.187 0-.351-.082-.492-.248l-5.178-6.589-1.448 1.374v5.111c0 .235-.117.352-.351.352H5.505c-.236 0-.354-.117-.354-.352V.353c0-.233.118-.353.354-.353h2.431c.234 0 .351.12.351.353v14.343l6.203-6.272c.165-.165.33-.246.495-.246h3.239c.144 0 .236.06.285.18.046.149.034.255-.036.315l-6.555 6.344 6.836 8.507c.095.104.117.208.07.334"/>
          </svg>
        </a>
        <a href={`mailto:${SOCIAL.email}`} aria-label="Email" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m2 7 10 7 10-7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Avatar / decorative -->
    <div class="hidden md:block relative animate-fadein" style="animation-delay:0.3s">
      <div class="w-64 h-64 lg:w-80 lg:h-80 relative">
        <!-- Decorative frame -->
        <div class="absolute inset-0 border-2 border-[var(--color-accent)] translate-x-3 translate-y-3 rounded-sm"></div>
        <div class="relative w-full h-full bg-[var(--color-accent-light)] rounded-sm overflow-hidden">
          <!-- Replace /avatar.jpg with your actual photo in /public -->
          <img
            src="/avatar.jpg"
            alt="Madhumitha Anand"
            class="w-full h-full object-cover"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
          />
          <!-- Placeholder if no image -->
          <div class="absolute inset-0 hidden items-center justify-center" id="avatar-placeholder">
            <span class="font-display text-6xl text-[var(--color-accent)] opacity-30">MA</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes fadein {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fadein {
    animation: fadein 0.7s ease both;
  }
</style>

<script>
  // Show placeholder if image errors
  const img = document.querySelector('#hero img') as HTMLImageElement;
  const placeholder = document.getElementById('avatar-placeholder');
  if (img && placeholder) {
    img.addEventListener('error', () => {
      img.style.display = 'none';
      placeholder.style.display = 'flex';
    });
  }
</script>
